{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "pomagier",
  "instructions": ["AGENTS.md"],
  "plugin": [
    "opencode-skills-collection@latest",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "compaction": {
    "auto": true,
    "tail_turns": 20
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "git push*": "ask",
      "git commit*": "ask",
      "rm *": "ask",
      "docker*": "ask",
      "npm publish*": "deny",
      "npm install -g*": "ask",
      "*": "allow"
    },
    "external_directory": {
      "*": "allow"
    },
    "webfetch": "allow",
    "todowrite": "allow"
  }
}
